# All three are required. Without them the contact route returns 500 rather
# than silently accepting a message it cannot send.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# The From address for every send. Must be at a domain verified in the
# Resend account — resend.dev addresses only work for testing, only as
# onboarding@resend.dev, and only deliver to the Resend account owner's own
# address. In production a resend.dev From is refused by Resend.
MAIL_FROM=

# Leasing enquiries. Falls back to CONTACT_TO_EMAIL when unset, but a leasing
# lead sitting in the general inbox is a lead nobody actions. Routed
# separately because the published leasing address (Foundry Commercial) has
# never worked — see constraints.md D1 — and the leasing page's inquiry form
# is currently the only working leasing channel; misrouting it back into the
# general inbox recreates the same "nobody sees the lead" failure.
LEASING_TO_EMAIL=

# Used by sitemap.ts and robots.ts. Set to the production origin at deploy time.
SITE_URL=
